   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libGLdispatch.so*
   ...
}
{
   wsl_libd3d12_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libd3d12.so*
   ...
}
{
   wsl_libd3d12core_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libd3d12core.so*
   ...
}
{
   mesa_swrast_dri_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/swrast_dri.so*
   ...
}
{
   glibc_rtld_dl_open_reachable
   Memcheck:Leak
   match-leak-kinds:reachable
   fun:calloc
   fun:_dl_new_object
   fun:_dl_map_object_from_fd
   fun:_dl_map_object
   fun:openaux
   fun:_dl_map_object_deps
   fun:dl_open_worker_begin
   fun:dl_open_worker
   fun:_dl_open
}
{
   glibc_rtld_lookup_symbol_reachable
   Memcheck:Leak
   match-leak-kinds:reachable
   fun:calloc
   fun:do_lookup_unique
   fun:do_lookup_x
   fun:_dl_lookup_symbol_x
   fun:resolve_map
   fun:_dl_relocate_object
   fun:dl_open_worker_begin
   fun:dl_open_worker
   fun:_dl_open
}
{
   glibc_rtld_check_versions_reachable
   Memcheck:Leak
   match-leak-kinds:reachable
   fun:calloc
   fun:_dl_check_map_versions
   fun:dl_open_worker_begin
   fun:dl_open_worker
   fun:_dl_open
}
