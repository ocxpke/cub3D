# Suppressions for leaks coming from MLX42 and its windowing stack (GLFW/X11/GL)
# Usage:
# valgrind --leak-check=full --show-leak-kinds=all \
#   --suppressions=./valgrind-mlx.supp ./build/minirt <scene.rt>
{
   mlx42_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   fun:mlx_*
   ...
}
{
   glfw_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   fun:glfw*
   ...
}
{
   x11_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libX11.so*
   ...
}
{
   xext_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libXext.so*
   ...
}
{
   xrandr_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libXrandr.so*
   ...
}
{
   xcursor_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libXcursor.so*
   ...
}
{
   xinerama_any_leak
   Memcheck:Leak
   match-leak-kinds:all
   ...
   obj:*/libXinerama.so*
   ...
}
